// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TeeSource {
  API             @map("api")
  FALLBACK_SCRAPE @map("fallback_scrape")
  MANUAL          @map("manual")
}

enum ScorecardSource {
  API
  PLAYER_APPROVED
  ADMIN
}

enum RoundScorecardStatus {
  VERIFIED
  PENDING_REVIEW
  REJECTED
}

enum WeatherCondition {
  DRY
  MOIST
  WET
  SUPER_WET
}

enum UserRole {
  PLAYER
  ADMIN
}

enum SubmissionType {
  IDEA
  ISSUE
  DATA_CORRECTION
  MISSING_COURSE
  SCORECARD_REVIEW
}

enum SubmissionStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id                     String              @id @default(uuid()) @db.Uuid
  authUserId             String?             @unique @db.Uuid
  name                   String
  email                  String              @unique
  role                   UserRole            @default(PLAYER)
  homeClubId             String?             @db.Uuid
  handicapIndex          Decimal?            @db.Decimal(4, 1)
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  homeClub               Club?               @relation(fields: [homeClubId], references: [id], onDelete: SetNull)
  rounds                 Round[]
  submissions            Submission[]
  sentSubmissionMessages SubmissionMessage[] @relation("SubmissionMessageSender")
  adminAuditLogs         AdminAuditLog[]     @relation("AdminAuditActor")
  reviewedScorecards     ScorecardReview[]   @relation("ScorecardReviewer")
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @db.Uuid
  action      String   @db.VarChar(80)
  targetType  String   @db.VarChar(80)
  targetId    String?  @db.VarChar(128)
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  actor       User     @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}

model Submission {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @db.Uuid
  type            SubmissionType
  status          SubmissionStatus    @default(NEW)
  subject         String              @db.VarChar(120)
  message         String              @db.VarChar(2000)
  clubName        String?             @db.VarChar(160)
  townCounty      String?             @db.VarChar(160)
  websiteUrl      String?             @db.VarChar(500)
  courseName      String?             @db.VarChar(160)
  teeDetails      String?             @db.VarChar(1000)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages        SubmissionMessage[]
  scorecardReview ScorecardReview?

  @@index([userId, createdAt])
  @@index([status, type, createdAt])
}

model SubmissionMessage {
  id           String     @id @default(uuid()) @db.Uuid
  submissionId String     @db.Uuid
  senderUserId String     @db.Uuid
  body         String     @db.VarChar(2000)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  sender       User       @relation("SubmissionMessageSender", fields: [senderUserId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
  @@index([senderUserId, createdAt])
}

model Club {
  id           String   @id @default(uuid()) @db.Uuid
  externalId   String?  @unique @db.Uuid
  name         String
  city         String?  @db.VarChar(160)
  county       String?  @db.VarChar(160)
  postcode     String?  @db.VarChar(16)
  countryCode  String?  @db.VarChar(3)
  latitude     Float?
  longitude    Float?
  googleRating Float?
  clubType     String?  @db.VarChar(80)
  courseType   String?  @db.VarChar(80)
  members      User[]
  courses      Course[]

  @@index([name])
}

model Course {
  id         String  @id @default(uuid()) @db.Uuid
  externalId String? @unique @db.Uuid
  clubId     String  @db.Uuid
  name       String
  holes      Int?
  par        Int?
  designedBy String? @db.VarChar(200)
  yearOpened String? @db.VarChar(20)
  club       Club    @relation(fields: [clubId], references: [id])
  tees       Tee[]

  @@index([name])
  @@index([clubId, name])
}

model Tee {
  id               String            @id @default(uuid()) @db.Uuid
  externalId       String?           @unique @db.Uuid
  courseId         String            @db.Uuid
  teeName          String
  colour           String?           @db.VarChar(80)
  gender           String?           @db.VarChar(40)
  totalYardage     Int?
  totalMetres      Int?
  courseRating     Decimal           @db.Decimal(4, 1)
  slopeRating      Int
  par              Int?
  source           TeeSource
  course           Course            @relation(fields: [courseId], references: [id])
  rounds           Round[]
  holes            TeeHole[]
  scorecardReviews ScorecardReview[]

  @@index([courseId, teeName])
}

model Round {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @db.Uuid
  teeId              String               @db.Uuid
  datePlayed         DateTime             @db.Date
  grossScore         Int
  adjustedGrossScore Int
  isCapped           Boolean              @default(false)
  weatherCondition   WeatherCondition
  /// Manual override; automated club-wide PCC calculation is out of scope.
  pccAdjustment      Decimal              @default(0) @db.Decimal(2, 1)
  scoreDifferential  Decimal              @db.Decimal(4, 1)
  user               User                 @relation(fields: [userId], references: [id])
  tee                Tee                  @relation(fields: [teeId], references: [id])
  /// Explicitly determined by the application's handicap rules configuration.
  isAcceptable       Boolean
  /// Uses the product's simplified best 8 of up to 20 recent acceptable rounds.
  usedInHandicapCalc Boolean              @default(false)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  holeScores         HoleScore[]
  scorecardStatus    RoundScorecardStatus @default(VERIFIED)
  scorecardReview    ScorecardReview?
}

model TeeHole {
  id          String          @id @default(uuid()) @db.Uuid
  teeId       String          @db.Uuid
  holeNumber  Int
  par         Int
  strokeIndex Int
  yardage     Int?
  source      ScorecardSource
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  tee         Tee             @relation(fields: [teeId], references: [id], onDelete: Cascade)

  @@unique([teeId, holeNumber])
  @@index([teeId])
}

model ScorecardReview {
  id           String                @id @default(uuid()) @db.Uuid
  submissionId String                @unique @db.Uuid
  teeId        String                @db.Uuid
  roundId      String                @unique @db.Uuid
  reviewedById String?               @db.Uuid
  reviewedAt   DateTime?             @db.Timestamptz(3)
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(3)
  submission   Submission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  tee          Tee                   @relation(fields: [teeId], references: [id], onDelete: Restrict)
  round        Round                 @relation(fields: [roundId], references: [id], onDelete: Restrict)
  reviewedBy   User?                 @relation("ScorecardReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  holes        ScorecardReviewHole[]

  @@index([teeId, createdAt])
  @@index([reviewedById, reviewedAt])
}

model ScorecardReviewHole {
  id                String          @id @default(uuid()) @db.Uuid
  scorecardReviewId String          @db.Uuid
  holeNumber        Int
  par               Int
  strokeIndex       Int
  yardage           Int?
  scorecardReview   ScorecardReview @relation(fields: [scorecardReviewId], references: [id], onDelete: Cascade)

  @@unique([scorecardReviewId, holeNumber])
}

model HoleScore {
  id           String @id @default(uuid()) @db.Uuid
  roundId      String @db.Uuid
  holeNumber   Int
  par          Int
  strokeIndex  Int
  strokesTaken Int
  round        Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, holeNumber])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TeeSource {
  API             @map("api")
  FALLBACK_SCRAPE @map("fallback_scrape")
  MANUAL          @map("manual")
}

enum WeatherCondition {
  DRY
  MOIST
  WET
  SUPER_WET
}

enum UserRole {
  PLAYER
  ADMIN
}

enum SubmissionType {
  IDEA
  ISSUE
  DATA_CORRECTION
  MISSING_COURSE
}

enum SubmissionStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id                     String              @id @default(uuid()) @db.Uuid
  authUserId             String?             @unique @db.Uuid
  name                   String
  email                  String              @unique
  role                   UserRole            @default(PLAYER)
  homeClubId             String?             @db.Uuid
  handicapIndex          Decimal?            @db.Decimal(4, 1)
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  homeClub               Club?               @relation(fields: [homeClubId], references: [id], onDelete: SetNull)
  rounds                 Round[]
  submissions            Submission[]
  sentSubmissionMessages SubmissionMessage[] @relation("SubmissionMessageSender")
  adminAuditLogs         AdminAuditLog[]     @relation("AdminAuditActor")
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @db.Uuid
  action      String   @db.VarChar(80)
  targetType  String   @db.VarChar(80)
  targetId    String?  @db.VarChar(128)
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  actor       User     @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}

model Submission {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  type       SubmissionType
  status     SubmissionStatus    @default(NEW)
  subject    String              @db.VarChar(120)
  message    String              @db.VarChar(2000)
  clubName   String?             @db.VarChar(160)
  townCounty String?             @db.VarChar(160)
  websiteUrl String?             @db.VarChar(500)
  courseName String?             @db.VarChar(160)
  teeDetails String?             @db.VarChar(1000)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @db.Timestamptz(3)
  user       User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages   SubmissionMessage[]

  @@index([userId, createdAt])
  @@index([status, type, createdAt])
}

model SubmissionMessage {
  id           String     @id @default(uuid()) @db.Uuid
  submissionId String     @db.Uuid
  senderUserId String     @db.Uuid
  body         String     @db.VarChar(2000)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  sender       User       @relation("SubmissionMessageSender", fields: [senderUserId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
  @@index([senderUserId, createdAt])
}

model Club {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  latitude  Float?
  longitude Float?
  members   User[]
  courses   Course[]
}

model Course {
  id     String @id @default(uuid()) @db.Uuid
  clubId String @db.Uuid
  name   String
  club   Club   @relation(fields: [clubId], references: [id])
  tees   Tee[]
}

model Tee {
  id           String    @id @default(uuid()) @db.Uuid
  courseId     String    @db.Uuid
  teeName      String
  courseRating Decimal   @db.Decimal(4, 1)
  slopeRating  Int
  par          Int?
  source       TeeSource
  course       Course    @relation(fields: [courseId], references: [id])
  rounds       Round[]
}

model Round {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @db.Uuid
  teeId              String           @db.Uuid
  datePlayed         DateTime         @db.Date
  grossScore         Int
  adjustedGrossScore Int
  isCapped           Boolean          @default(false)
  weatherCondition   WeatherCondition
  /// Manual override; automated club-wide PCC calculation is out of scope.
  pccAdjustment      Decimal          @default(0) @db.Decimal(2, 1)
  scoreDifferential  Decimal          @db.Decimal(4, 1)
  user               User             @relation(fields: [userId], references: [id])
  tee                Tee              @relation(fields: [teeId], references: [id])
  /// Explicitly determined by the application's handicap rules configuration.
  isAcceptable       Boolean
  /// Uses the product's simplified best 8 of up to 20 recent acceptable rounds.
  usedInHandicapCalc Boolean          @default(false)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  holeScores         HoleScore[]
}

model HoleScore {
  id           String @id @default(uuid()) @db.Uuid
  roundId      String @db.Uuid
  holeNumber   Int
  par          Int
  strokeIndex  Int
  strokesTaken Int
  round        Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, holeNumber])
}

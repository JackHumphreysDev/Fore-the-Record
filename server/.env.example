# Runtime connection used by Vercel and the Express API
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"

# Direct or session connection used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_OR_SESSION_HOST:5432/postgres"

# Supabase Auth public project configuration. The publishable key is designed
# to be exposed to the browser; never substitute a service-role secret here.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Server-only Supabase administrator key used for secure player invitations,
# Auth email changes, suspensions, and deletions. Never add this to the client,
# expose it through a VITE_ variable, or commit a real value.
SUPABASE_SECRET_KEY="sb_secret_your-server-only-key"

# One-time local bootstrap only. Set this to an existing claimed profile before
# running admin:promote, then remove it. Do not configure it in Vercel.
ADMIN_EMAIL="owner@example.com"

# UK Golf Course Data API lookup and catalogue-import configuration. A dry-run
# still consumes provider requests, so confirm the subscribed quota first.
RAPIDAPI_KEY="your-rapidapi-key"
RAPIDAPI_HOST="uk-golf-course-data-api.p.rapidapi.com"
RAPIDAPI_SEARCH_PATH="/clubs"
RAPIDAPI_SEARCH_QUERY_PARAM="search"
